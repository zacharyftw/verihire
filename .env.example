# ===========================================
# VeriHire Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
APP_NAME=VeriHire
APP_URL=http://localhost:3100
API_URL=http://localhost:4100

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Storage (Supabase S3-compatible)
S3_ENDPOINT=https://YOUR_PROJECT.supabase.co/storage/v1/s3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=verihire

# JWT Authentication
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI (Groq - OpenAI-compatible, Llama 3.3 70B)
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Judge0 CE (Code Execution Sandbox)
# Local: http://localhost:2358
# Production: use ngrok tunnel URL pointing to local Judge0
JUDGE0_URL=http://localhost:2358

# Blockchain (Polygon Amoy testnet - certificate anchoring)
POLYGON_RPC_URL=https://polygon-amoy.infura.io/v3/YOUR_KEY
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
FEATURE_BLOCKCHAIN_ENABLED=false

# Certificate Signing (ECDSA secp256k1)
# Generate with: openssl ecparam -name secp256k1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
CERTIFICATE_SIGNING_PRIVATE_KEY=
CERTIFICATE_SIGNING_PUBLIC_KEY=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3100

# Email hash salt (for certificate email hashing)
EMAIL_HASH_SALT=change-me-in-production
