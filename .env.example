# ===========================================
# VeriHire Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
APP_NAME=VeriHire
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://verihire:verihire_dev@localhost:5432/verihire?schema=public
POSTGRES_USER=verihire
POSTGRES_PASSWORD=verihire_dev
POSTGRES_DB=verihire

# Redis
REDIS_URL=redis://:verihire_dev@localhost:6379
REDIS_PASSWORD=verihire_dev

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=verihire
MINIO_ROOT_PASSWORD=verihire_dev
MINIO_BUCKET=verihire-uploads
MINIO_USE_SSL=false

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800

# OAuth Providers (optional for development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Email (Mailhog for development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@verihire.local

# OpenAI (for AI features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# Blockchain (for certificate anchoring)
POLYGON_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/your-key
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=

# Sentry (error tracking)
SENTRY_DSN=

# Feature Flags
FEATURE_MFA_ENABLED=true
FEATURE_BLOCKCHAIN_ENABLED=false
FEATURE_AI_EVALUATION_ENABLED=true
