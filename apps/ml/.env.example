# VeriHire ML Service Environment Variables

# Service configuration
APP_NAME=VeriHire ML Service
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Server configuration
HOST=0.0.0.0
PORT=4200

# Redis configuration (for caching)
REDIS_URL=redis://localhost:6379

# Model configuration
MODEL_CACHE_DIR=/tmp/verihire-models
# Device: cuda, cpu, or auto (auto-detect)
DEVICE=auto

# Hugging Face model names
CODEBERT_MODEL=microsoft/codebert-base
BERT_MODEL=bert-base-uncased

# Scoring configuration
CODE_QUALITY_THRESHOLD=0.7
TEXT_QUALITY_THRESHOLD=0.7

# Scoring mode: heuristic (default), ml, or hybrid
# - heuristic: Rule-based scoring (no trained models needed)
# - ml: Use trained classification heads for scoring
# - hybrid: Blend ML and heuristic scores
SCORING_MODE=heuristic

# Paths to trained classifier checkpoints (required for ml/hybrid modes)
# CODE_QUALITY_CLASSIFIER_PATH=/path/to/checkpoints/code_quality_classifier_best.pt
# TEXT_QUALITY_CLASSIFIER_PATH=/path/to/checkpoints/text_quality_classifier_best.pt

# Weight for ML scores in hybrid mode (0-1, default 0.7)
HYBRID_ML_WEIGHT=0.7

# NCF model configuration
NCF_EMBEDDING_DIM=64
# NCF_HIDDEN_LAYERS=[128, 64, 32]

# API configuration
API_V1_PREFIX=/api/v1
